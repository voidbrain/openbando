{
  "template": {
    "path": "~/Projects/project-harness",
    "repo": "https://github.com/voidbrain/project-harness"
  },
  "version": "1.11.0",
  "stacks": [
    "core",
    "angular"
  ],
  "copied": {
    "tools/check-backlog.mjs": "core/tools/check-backlog.mjs",
    "tools/check-freshness.mjs": "core/tools/check-freshness.mjs",
    "tools/check-harness.mjs": "core/tools/check-harness.mjs",
    "tools/ci-status.mjs": "core/tools/ci-status.mjs",
    "tools/check-conventions.mjs": "angular/tools/check-conventions.mjs"
  },
  "forked": {},
  "adapted": {
    "AGENTS.md": [
      "core/AGENTS.md",
      "angular/AGENTS.angular.md"
    ],
    "CLAUDE.md": "core/CLAUDE.md",
    "README.md": "core/README.md",
    "docs/BACKLOG.md": "core/docs/BACKLOG.md",
    "docs/BACKLOG-RULES.md": "core/docs/BACKLOG-RULES.md",
    "docs/agents/areas.md": "core/docs/agents/areas.md",
    "eslint.config.mjs": "angular/eslint.config.mjs",
    ".github/workflows/ci.yml": "angular/.github/workflows/ci.yml",
    "package.json": "angular/package-scripts.json",
    "design-system/README.md": "core/docs/STYLE-GUIDE.md"
  },
  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "e2e|browser",
    "logNotes": [
      "^auto-sync found"
    ]
  },
  "conventions": {
    "pureDirs": [
      [
        "src/app/core/",
        [
          "signal",
          "computed",
          "untracked"
        ]
      ]
    ]
  },
  "note": "OpenBando is the reference implementation the template was extracted from (1.0.0); stamped at 1.1.1 on 2026-10-29.",
  "impact": [
    {
      "when": [
        "src/app/core/tour.ts",
        "tools/build-guide.mjs"
      ],
      "then": "regenerate the guide pages in docs/guide/",
      "run": "node tools/build-guide.mjs",
      "checked": "CI (guide pages match the tour)"
    },
    {
      "when": [
        "src/app/core/tour.ts",
        "src/app/ui/**/*.html",
        "src/app/ui/**/*.scss",
        "src/styles.scss",
        "e2e/clips.record.ts",
        "e2e/welcome-films.record.ts"
      ],
      "then": "check whether a guide clip or Welcome film shows what changed, and re-record it (a browser workflow, not regenerated by the guide)",
      "run": "npm run clips / npm run films",
      "checked": "nothing yet (F-031)"
    },
    {
      "when": [
        "src/app/ui/**/*.html"
      ],
      "then": "every new user-facing text has its Italian, and every new control its tip (title / tip on hover)",
      "run": "npm run check:i18n",
      "checked": "check:i18n for texts; nothing yet for tips (F-026)"
    },
    {
      "when": [
        "src/app/core/fences.ts",
        "src/app/core/layers.ts",
        "src/app/core/blocks.ts",
        "src/app/three/structures.ts",
        "src/app/ui/**/*.ts"
      ],
      "then": "labels and hints written in TypeScript data (fence, surface, road, structure lists, tool hints, menus) have their Italian in src/app/i18n/it.ts",
      "checked": "check:i18n (labels and hints in TypeScript data)",
      "run": "npm run check:i18n"
    },
    {
      "when": [
        "src/app/services/shortcuts.service.ts"
      ],
      "then": "the Help panel lists the keys (ui/panels/help-panel.ts)",
      "checked": "nothing"
    },
    {
      "when": [
        "src/app/core/site-spec.ts",
        "src/app/core/ai-commands.ts"
      ],
      "then": "a new spec field or AI command keeps sanitizeSpec, cloneSpec, AI_SCHEMA, SYSTEM_PROMPT and normalizeCommands in step (AGENTS, Adding things)",
      "checked": "ai-commands.spec.ts, partly"
    },
    {
      "when": [
        "tools/examples/**",
        "src/app/core/site-spec.ts",
        "src/app/three/**"
      ],
      "then": "rebuild the example bandos and the catalogue",
      "run": "npm run examples",
      "checked": "CI (generated examples must match)"
    },
    {
      "when": [
        "library/blocks/**"
      ],
      "then": "republish the catalogue",
      "run": "node tools/build-catalog.mjs",
      "checked": "CI (catalogue)"
    },
    {
      "when": [
        "src/styles.scss",
        "src/app/ui/**/*.scss"
      ],
      "then": "a new token, tool colour or shared component updates design-system/ (tokens.json, the component's guide)",
      "checked": "check:contrast (tokens and text/surface pairs)"
    }
  ]
}
