  "outside": [
    {
      "what": "Library upgrades (three.js, Angular, Playwright; package-lock.json)",
      "affects": "rendering, the UI, the recordings, browser-test timing",
      "noticed": "the impact row \"lockfile\"; the e2e jobs; the audit"
    },
    {
      "what": "The CI browser and machine (Playwright browsers, software WebGL on the runner)",
      "affects": "browser-test timing and what the tests see",
      "noticed": "CI failures and retries (ci:status); the audit"
    },
    {
      "what": "OpenStreetMap / Overpass",
      "affects": "new bandos generated from the map (the examples use stored data)",
      "noticed": "pilots' reports; generation errors in the app"
    },
    {
      "what": "Terrain tiles (AWS Terrarium)",
      "affects": "the real ground of new bandos",
      "noticed": "generation errors; the audit"
    },
    {
      "what": "Nominatim (place search)",
      "affects": "the New bando search",
      "noticed": "the app's toast (no location / unreachable)"
    },
    {
      "what": "Satellite imagery (Esri)",
      "affects": "the satellite ground and map",
      "noticed": "looking at it; the audit"
    },
    {
      "what": "AI models (the assistant)",
      "affects": "what the AI assistant does with a request",
