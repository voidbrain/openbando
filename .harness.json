  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "e2e|browser",
    "logNotes": [
      "^auto-sync found"
    ]
  },
  "conventions": {
    "pureDirs": [
      [
        "src/app/core/",
        [
          "signal",
          "computed",
          "untracked"
        ]
      ]
    ]
  },
  "note": "OpenBando is the reference implementation extracted into the harness. Reconciled 2026-10-31 from the recorded 2.0.1 source commit 9c3abc6d0758feb445b00f82953e0a4fb2c663b1 to published v2.2.2 (0764a362d3c81d828ff6f1bf936e3a2782f19339). The former 2.0.1 stamp had no published tag; its recorded source commit was used for the comparison. Optional integration metadata/guides adopted without installing servers or skills; no solution role selected. ESLint config was a stale adapted entry with no file or lint script and is intentionally not adopted; check:conventions remains the existing checker. Reconciled next to published v3.1.1 (7a81b930c5cbd689b8db9d4c74f9dd42ec1e7031): required input-bound maintenance evidence and scheduled checks; optional scope-aware audit enforcement stays off until a full product baseline is reviewed; coverage remains warning-only. Project rules, product acceptance and existing impact/coupling mappings preserved.",
  "impact": [
    {
      "id": "lockfile",
      "when": [
        "package-lock.json"
      ],
      "then": "a library was upgraded (three.js, Angular, Playwright): run the browser tests and look at the 3D views; if rendering changed, the recordings below follow",
      "checked": "the e2e jobs (behaviour); nothing for looks"
    },
    {
      "id": "theme",
      "when": [
        "src/styles.scss",
        "design-system/tokens.json"
      ],
      "then": "a theme colour, font or size reaches every visual output: the design-system guides, the recordings and the art below follow",
      "checked": "check:contrast (tokens and text/surface pairs)"
    },
    {
      "id": "art",
      "when": [
        "public/mascot/**",
        "docs/mascot/**"
      ],
      "then": "the mascot and wordmark art follow the theme and the Welcome films (re-export from their masters, see the mascot and wordmark guides)",
      "checked": "nothing",
      "after": [
        "theme"
      ]
    },
    {
      "id": "design-system",
      "when": [
        "src/app/ui/**/*.scss"
      ],
      "then": "a new token, tool colour or shared component updates design-system/ (tokens.json, the component's guide)",
      "checked": "check:contrast (tokens)",
      "after": [
        "theme"
      ]
    },
    {
      "id": "clips",
      "when": [
        "src/app/core/tour.ts",
        "src/app/services/tour.service.ts",
        "src/styles.scss",
        "e2e/clips.record.ts",
        "src/app/ui/**/*.html",
        "src/app/ui/**/*.scss",
        "src/app/ui/**/*.ts"
      ],
      "inputs": [
        "library/bandos/chiari-e-forti.json",
        "library/bandos/villetta-no-place.json",
        "public/guide-demo/**"
      ],
      "then": "re-record the guide clips whose step shows what changed (a browser workflow, not done by CI)",
      "run": "npm run clips",
      "checked": "check:media (warns when what a clip shows changed since, and names the clips whose own controls changed)",
      "after": [
        "theme",
        "lockfile"
      ]
    },
    {
      "id": "guide",
      "when": [
        "src/app/core/tour.ts",
        "tools/build-guide.mjs"
      ],
      "then": "regenerate the guide pages in docs/guide/ (they embed the clips)",
      "run": "node tools/build-guide.mjs",
      "checked": "CI (guide pages match the tour)",
      "after": [
        "clips"
      ]
    },
    {
      "id": "films",
      "when": [
        "src/app/ui/panels/welcome-panel.ts",
        "src/app/ui/studio/**",
        "src/app/three/**",
        "src/app/services/tour.service.ts",
        "src/styles.scss",
        "e2e/welcome-films.record.ts"
      ],
      "inputs": [
        "library/bandos/chiari-e-forti.json",
        "library/bandos/villetta-no-place.json",
        "public/guide-demo/**"
      ],
      "then": "re-record the three Welcome films (build and share film Chiari e Forti, fly plays the showcase flight)",
      "run": "npm run films",
      "checked": "check:media; the showcase test checks the films' length against the mascot loop",
      "after": [
        "theme",
        "lockfile"
      ]
    },
    {
      "id": "i18n",
      "when": [
        "src/app/**/*.html",
        "src/app/**/*.ts"
      ],
      "then": "every new user-facing text (templates, toasts, labels and hints in TypeScript data) has its Italian in src/app/i18n/it.ts",
      "run": "npm run check:i18n",
      "checked": "check:i18n"
    },
    {
      "id": "tips",
      "when": [
        "src/app/**/*.html"
      ],
      "then": "a new control gets its tip (a title, or a guide step that shows it on hover)",
      "checked": "nothing yet (F-026)"
    },
    {
      "id": "element-map",
      "when": [
        "src/app/**/*.html",
        "src/app/ui/**/*.ts",
        "src/app/core/tour.ts",
        "src/app/services/shortcuts.service.ts",
        "src/app/core/radio/radio-input.ts",
        "design-system/components/*.md"
      ],
      "then": "regenerate the element map (docs/agents/element-map.md) and each clip's sources (docs/guide/clip-sources.json)",
      "run": "node tools/build-element-map.mjs",
      "checked": "CI (element map matches the code)"
    },
    {
      "id": "help-keys",
      "when": [
        "src/app/services/shortcuts.service.ts"
      ],
      "then": "the Help panel lists the keys (ui/panels/help-panel.ts)",
      "checked": "nothing"
    },
    {
      "id": "spec-ai",
      "when": [
        "src/app/core/site-spec.ts",
        "src/app/core/ai-commands.ts",
        "src/app/core/ai-prompt.ts"
      ],
      "then": "a new spec field or AI command keeps sanitizeSpec, cloneSpec, AI_SCHEMA, SYSTEM_PROMPT and normalizeCommands in step (AGENTS, Adding things)",
      "checked": "ai-commands.spec.ts, partly"
    },
    {
      "id": "catalogue",
      "when": [
        "library/blocks/**",
        "tools/build-catalog.mjs"
      ],
      "then": "republish the catalogue",
      "run": "node tools/build-catalog.mjs",
      "checked": "CI (catalogue)"
    },
    {
      "id": "examples",
      "when": [
        "tools/examples/**",
        "src/app/core/site-spec.ts",
        "src/app/three/**"
      ],
      "inputs": [
        "tools/examples/data/**"
      ],
      "then": "rebuild the example bandos (they place catalogue blocks)",
      "run": "npm run examples",
      "checked": "CI (generated examples must match)",
      "after": [
        "catalogue"
      ]
    },
    {
      "id": "panels",
      "when": [
        "src/app/ui/panel-defs.ts",
        "src/app/ui/panels/**"
      ],
      "then": "a new or renamed panel gets its Views entry, its guide step (core/tour.ts) and its line in the README",
      "checked": "nothing"
    },
    {
      "id": "docs",
      "when": [
        "src/app/ui/**",
        "src/app/three/**",
        "src/app/core/**",
        "src/app/services/**"
      ],
      "then": "a new or changed feature updates the README (what the app does) and the area's notes in docs/agents/areas.md",
      "checked": "nothing (BACKLOG-RULES, Documentation consistency)"
    },
    {
      "id": "impact-page",
      "when": [
        ".harness.json"
      ],
      "then": "regenerate the impact map page",
      "run": "node tools/impact-map.mjs",
      "checked": "CI (impact map page matches the rows)"
    },
    {
      "id": "coverage",
      "when": [
        "src/app/**/*.ts"
      ],
      "then": "when coverage changes on purpose (code removed, tests added), refresh the coverage table and its baseline",
      "run": "npm run coverage",
      "checked": "CI (warns when a folder drops more than 2 points)"
    }
  ],
  "couplings": [
    {
      "value": "Welcome film length (8 s)",
