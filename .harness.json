{
  "template": {
    "path": "~/Projects/project-harness",
    "repo": "https://github.com/voidbrain/project-harness"
  },
  "version": "1.17.1",
  "stacks": [
    "core",
    "angular"
  ],
  "copied": {
    "tools/check-backlog.mjs": "core/tools/check-backlog.mjs",
    "tools/check-freshness.mjs": "core/tools/check-freshness.mjs",
    "tools/check-harness.mjs": "core/tools/check-harness.mjs",
    "tools/ci-status.mjs": "core/tools/ci-status.mjs",
    "tools/check-conventions.mjs": "angular/tools/check-conventions.mjs",
    "tools/impact-map.mjs": "core/tools/impact-map.mjs",
    "tools/coverage-table.mjs": "core/tools/coverage-table.mjs",
    "tools/merge-backlog.mjs": "core/tools/merge-backlog.mjs",
    "tools/merge-when-green.mjs": "core/tools/merge-when-green.mjs"
  },
  "forked": {},
  "adapted": {
    "AGENTS.md": [
      "core/AGENTS.md",
      "angular/AGENTS.angular.md"
    ],
    "CLAUDE.md": "core/CLAUDE.md",
    "README.md": "core/README.md",
    "docs/BACKLOG.md": "core/docs/BACKLOG.md",
    "docs/BACKLOG-RULES.md": "core/docs/BACKLOG-RULES.md",
    "docs/agents/areas.md": "core/docs/agents/areas.md",
    "eslint.config.mjs": "angular/eslint.config.mjs",
    ".github/workflows/ci.yml": "angular/.github/workflows/ci.yml",
    "package.json": "angular/package-scripts.json",
    "design-system/README.md": "core/docs/STYLE-GUIDE.md"
  },
  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "e2e|browser",
    "logNotes": [
      "^auto-sync found"
    ]
  },
  "conventions": {
    "pureDirs": [
      [
        "src/app/core/",
        [
          "signal",
          "computed",
          "untracked"
        ]
      ]
    ]
  },
  "note": "OpenBando is the reference implementation the template was extracted from (1.0.0); stamped at 1.1.1 on 2026-10-29.",
  "impact": [
    {
      "id": "lockfile",
      "when": [
        "package-lock.json"
      ],
      "then": "a library was upgraded (three.js, Angular, Playwright): run the browser tests and look at the 3D views; if rendering changed, the recordings below follow",
      "checked": "the e2e jobs (behaviour); nothing for looks"
    },
    {
      "id": "theme",
      "when": [
        "src/styles.scss",
        "design-system/tokens.json"
      ],
      "then": "a theme colour, font or size reaches every visual output: the design-system guides, the recordings and the art below follow",
      "checked": "check:contrast (tokens and text/surface pairs)"
    },
    {
      "id": "art",
      "when": [
        "public/mascot/**",
        "docs/mascot/**"
      ],
      "then": "the mascot and wordmark art follow the theme and the Welcome films (re-export from their masters, see the mascot and wordmark guides)",
      "checked": "nothing",
      "after": [
        "theme"
      ]
    },
    {
      "id": "design-system",
      "when": [
        "src/app/ui/**/*.scss"
      ],
      "then": "a new token, tool colour or shared component updates design-system/ (tokens.json, the component's guide)",
      "checked": "check:contrast (tokens)",
      "after": [
        "theme"
      ]
    },
    {
      "id": "clips",
      "when": [
        "src/app/core/tour.ts",
        "src/app/services/tour.service.ts",
        "src/styles.scss",
        "e2e/clips.record.ts",
        "src/app/ui/**/*.html",
        "src/app/ui/**/*.scss",
        "src/app/ui/**/*.ts"
      ],
      "inputs": [
        "library/bandos/chiari-e-forti.json",
        "library/bandos/villetta-no-place.json",
        "public/guide-demo/**"
      ],
      "then": "re-record the guide clips whose step shows what changed (a browser workflow, not done by CI)",
      "run": "npm run clips",
      "checked": "check:media (warns when what a clip shows changed since, and names the clips whose own controls changed)",
      "after": [
        "theme",
        "lockfile"
      ]
    },
    {
      "id": "guide",
      "when": [
        "src/app/core/tour.ts",
        "tools/build-guide.mjs"
      ],
      "then": "regenerate the guide pages in docs/guide/ (they embed the clips)",
      "run": "node tools/build-guide.mjs",
      "checked": "CI (guide pages match the tour)",
      "after": [
        "clips"
      ]
    },
    {
      "id": "films",
      "when": [
        "src/app/ui/panels/welcome-panel.ts",
        "src/app/ui/studio/**",
        "src/app/three/**",
        "src/app/services/tour.service.ts",
        "src/styles.scss",
        "e2e/welcome-films.record.ts"
      ],
      "inputs": [
        "library/bandos/chiari-e-forti.json",
        "library/bandos/villetta-no-place.json",
        "public/guide-demo/**"
      ],
      "then": "re-record the three Welcome films (build and share film Chiari e Forti, fly plays the showcase flight)",
      "run": "npm run films",
      "checked": "check:media; the showcase test checks the films' length against the mascot loop",
      "after": [
        "theme",
        "lockfile"
      ]
    },
    {
      "id": "i18n",
      "when": [
        "src/app/**/*.html",
        "src/app/**/*.ts"
      ],
      "then": "every new user-facing text (templates, toasts, labels and hints in TypeScript data) has its Italian in src/app/i18n/it.ts",
      "run": "npm run check:i18n",
      "checked": "check:i18n"
    },
    {
      "id": "tips",
      "when": [
        "src/app/**/*.html"
      ],
      "then": "a new control gets its tip (a title, or a guide step that shows it on hover)",
      "checked": "nothing yet (F-026)"
    },
    {
      "id": "element-map",
      "when": [
        "src/app/**/*.html",
        "src/app/ui/**/*.ts",
        "src/app/core/tour.ts",
        "src/app/services/shortcuts.service.ts",
        "src/app/core/radio/radio-input.ts",
        "design-system/components/*.md"
      ],
      "then": "regenerate the element map (docs/agents/element-map.md) and each clip's sources (docs/guide/clip-sources.json)",
      "run": "node tools/build-element-map.mjs",
      "checked": "CI (element map matches the code)"
    },
    {
      "id": "help-keys",
      "when": [
        "src/app/services/shortcuts.service.ts"
      ],
      "then": "the Help panel lists the keys (ui/panels/help-panel.ts)",
      "checked": "nothing"
    },
    {
      "id": "spec-ai",
      "when": [
        "src/app/core/site-spec.ts",
        "src/app/core/ai-commands.ts",
        "src/app/core/ai-prompt.ts"
      ],
      "then": "a new spec field or AI command keeps sanitizeSpec, cloneSpec, AI_SCHEMA, SYSTEM_PROMPT and normalizeCommands in step (AGENTS, Adding things)",
      "checked": "ai-commands.spec.ts, partly"
    },
    {
      "id": "catalogue",
      "when": [
        "library/blocks/**",
        "tools/build-catalog.mjs"
      ],
      "then": "republish the catalogue",
      "run": "node tools/build-catalog.mjs",
      "checked": "CI (catalogue)"
    },
    {
      "id": "examples",
      "when": [
        "tools/examples/**",
        "src/app/core/site-spec.ts",
        "src/app/three/**"
      ],
      "inputs": [
        "tools/examples/data/**"
      ],
      "then": "rebuild the example bandos (they place catalogue blocks)",
      "run": "npm run examples",
      "checked": "CI (generated examples must match)",
      "after": [
        "catalogue"
      ]
    },
    {
      "id": "panels",
      "when": [
        "src/app/ui/panel-defs.ts",
        "src/app/ui/panels/**"
      ],
      "then": "a new or renamed panel gets its Views entry, its guide step (core/tour.ts) and its line in the README",
      "checked": "nothing"
    },
    {
      "id": "docs",
      "when": [
        "src/app/ui/**",
        "src/app/three/**",
        "src/app/core/**",
        "src/app/services/**"
      ],
      "then": "a new or changed feature updates the README (what the app does) and the area's notes in docs/agents/areas.md",
      "checked": "nothing (BACKLOG-RULES, Documentation consistency)"
    },
    {
      "id": "impact-page",
      "when": [
        ".harness.json"
      ],
      "then": "regenerate the impact map page",
      "run": "node tools/impact-map.mjs",
      "checked": "CI (impact map page matches the rows)"
    },
    {
      "id": "coverage",
      "when": [
        "src/app/**/*.ts"
      ],
      "then": "when coverage changes on purpose (code removed, tests added), refresh the coverage table and its baseline",
      "run": "npm run coverage",
      "checked": "CI (warns when a folder drops more than 2 points)"
    }
  ],
  "couplings": [
    {
      "value": "Welcome film length (8 s)",
      "places": [
        {
          "file": "e2e/welcome-films.record.ts",
          "what": "cut(\u2026, 8)"
        },
        {
          "file": "e2e/showcase.e2e.ts",
          "what": "films progress > 7.5 s"
        },
        {
          "file": "src/app/services/tour.service.ts",
          "what": "each film fitted to its third of MASCOT_DURATION"
        }
      ],
      "kept": "the showcase test (films play to their end within the mascot loop)"
    },
    {
      "value": "Demo flight offset (DEMO_OFFSET)",
      "places": [
        {
          "file": "src/app/services/tour.service.ts",
          "what": "DEMO_OFFSET"
        },
        {
          "file": "public/guide-demo/**",
          "what": "the demo flight and video"
        },
        {
          "file": "e2e/showcase.e2e.ts",
          "what": "-0.69 ± 0.15"
        }
      ],
      "kept": "the showcase test (a real Auto-sync scan finds the same offset)"
    },
    {
      "value": "Theme tokens",
      "places": [
        {
          "file": "src/styles.scss",
          "what": "--tokens"
        },
        {
          "file": "design-system/tokens.json"
        }
      ],
      "kept": "check:contrast (token catalogue matches CSS)"
    },
    {
      "value": "Fence materials",
      "places": [
        {
          "file": "src/app/core/fences.ts",
          "what": "FENCE_MATERIALS (the one list), FENCES"
        },
        {
          "file": "src/app/core/site-spec.ts",
          "what": "WallSpec.material"
        },
        {
          "file": "src/app/ui/studio/bando-editor.ts",
          "what": "FENCE_ICON"
        }
      ],
      "kept": "one source: FENCE_MATERIALS types WallSpec.material and FENCE_ICON; fences.spec.ts checks the menu (F-036)"
    },
    {
      "value": "Roof kinds",
      "places": [
        {
          "file": "src/app/core/site-spec.ts",
          "what": "ROOF_KINDS (the one list), LevelSpec.roof"
        },
        {
          "file": "src/app/core/ai-commands.ts",
          "what": "AiCommand.roof, normalizeCommands"
        },
        {
          "file": "src/app/core/ai-prompt.ts",
          "what": "AI_SCHEMA roof enum, SYSTEM_PROMPT"
        },
        {
          "file": "src/app/ui/studio/bando-editor.html",
          "what": "Roof → shape options"
        }
      ],
      "kept": "one source: ROOF_KINDS types the spec and the AI command and feeds AI_SCHEMA and the editor menu; ai-commands.spec.ts checks the schema, set_roof and the prompt prose (F-037)"
    },
    {
      "value": "Structure kinds",
      "places": [
        {
          "file": "src/app/core/site-spec.ts",
          "what": "StructureKind"
        },
        {
          "file": "src/app/three/structures.ts",
          "what": "STRUCTURE_DEFAULTS, RECT_KINDS"
        },
        {
          "file": "src/app/ui/studio/bando-editor.ts",
          "what": "structKinds"
        },
        {
          "file": "src/app/core/ai-commands.ts",
          "what": "STRUCTURE_KINDS"
        }
      ],
      "kept": "AGENTS (Adding things) and structures.spec.ts, partly"
    }
  ],
  "outside": [
    {
      "what": "Library upgrades (three.js, Angular, Playwright; package-lock.json)",
      "affects": "rendering, the UI, the recordings, browser-test timing",
      "noticed": "the impact row \"lockfile\"; the e2e jobs; the audit"
    },
    {
      "what": "The CI browser and machine (Playwright browsers, software WebGL on the runner)",
      "affects": "browser-test timing and what the tests see",
      "noticed": "CI failures and retries (ci:status); the audit"
    },
    {
      "what": "OpenStreetMap / Overpass",
      "affects": "new bandos generated from the map (the examples use stored data)",
      "noticed": "pilots' reports; generation errors in the app"
    },
    {
      "what": "Terrain tiles (AWS Terrarium)",
      "affects": "the real ground of new bandos",
      "noticed": "generation errors; the audit"
    },
    {
      "what": "Nominatim (place search)",
      "affects": "the New bando search",
      "noticed": "the app's toast (no location / unreachable)"
    },
    {
      "what": "Satellite imagery (Esri)",
      "affects": "the satellite ground and map",
      "noticed": "looking at it; the audit"
    },
    {
      "what": "AI models (the assistant)",
      "affects": "what the AI assistant does with a request",
      "noticed": "ai-commands tests use fixed replies; the audit"
    },
    {
      "what": "GitHub (Actions, Pages)",
      "affects": "CI and the live site",
      "noticed": "failed runs and deploys"
    }
  ],
  "pages": [
    {
      "title": "Element map",
      "path": "docs/agents/element-map.md",
      "about": "every control, its tip, the clips that show it"
    },
    {
      "title": "Guide",
      "path": "docs/guide/README.md",
      "about": "generated from the tour"
    },
    {
      "title": "Design system",
      "path": "design-system/README.md"
    },
    {
      "title": "Code coverage",
      "path": "docs/agents/coverage.md",
      "about": "unit tests, per folder; browser tests not counted"
    }
  ],
  "coverage": {
    "summary": "coverage/openbando/coverage-summary.json",
    "folders": [
      "src/app/core/",
      "src/app/three/",
      "src/app/services/",
      "src/app/state/",
      "src/app/ui/"
    ],
    "drop": 2
  }
}
