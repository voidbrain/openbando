  "pages": [
    {
      "title": "Element map",
      "path": "docs/agents/element-map.md",
      "about": "every control, its tip, the clips that show it"
    },
    {
      "title": "Guide",
      "path": "docs/guide/README.md",
      "about": "generated from the tour"
    },
    {
      "title": "Design system",
      "path": "design-system/README.md"
    },
    {
      "title": "Code coverage",
      "path": "docs/agents/coverage.md",
      "about": "unit tests, per folder; browser tests not counted"
    }
  ],
  "coverage": {
    "summary": "coverage/openbando/coverage-summary.json",
    "folders": [
