{
  "name": "openbando",
  "version": "0.0.0",
  "scripts": {
    "e2e": "playwright test",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "element-map": "node tools/build-element-map.mjs",
    "impact-map": "node tools/impact-map.mjs",
    "coverage": "ng test --watch=false --coverage --coverage-reporters=json-summary --coverage-include='src/**/*.ts' --coverage-exclude='**/*.spec.ts' && node tools/coverage-table.mjs --write",
    "examples": "esbuild tools/examples/build-examples.ts --bundle --platform=node --format=esm --outfile=.angular/build-examples.mjs --log-level=warning && node .angular/build-examples.mjs && node tools/build-catalog.mjs",
    "check:i18n": "esbuild tools/i18n/check-i18n.ts --bundle --platform=node --format=esm --outfile=.angular/check-i18n.mjs --log-level=warning && node .angular/check-i18n.mjs",
    "clips": "playwright test --config=playwright.clips.config.ts e2e/clips.record.ts && node tools/build-guide.mjs && node tools/check-media.mjs --stamp clips",
    "films": "playwright test --config=playwright.clips.config.ts e2e/welcome-films.record.ts && node tools/check-media.mjs --stamp films",
    "check:media": "node tools/check-media.mjs",
    "race:relay": "esbuild tools/racing/relay.ts --bundle --platform=node --format=esm --outfile=.angular/race-relay.mjs --log-level=warning && node .angular/race-relay.mjs",
    "test:race-relay": "esbuild tools/racing/relay.ts --bundle --platform=node --format=esm --outfile=.angular/race-relay.mjs --log-level=warning && node --test tools/racing/relay.test.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "check:backlog": "node tools/check-backlog.mjs",
    "ci:status": "node tools/ci-status.mjs",
    "check:freshness": "node tools/check-freshness.mjs",
    "check:conventions": "node tools/check-conventions.mjs",
    "check:integrations": "node tools/mcp.mjs check",
    "mcp:recommend": "node tools/mcp.mjs recommend",
    "reconcile:preview": "node tools/reconcile-preview.mjs",
    "friction": "node tools/friction.mjs",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:audits": "node tools/check-audits.mjs",
    "code:map": "node tools/code-map.mjs",
    "reconcile:draft": "node tools/reconcile-draft.mjs",
    "check:rules": "node tools/check-rules.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "rule-load": "node tools/rule-load.mjs",
    "check:rule-load": "node tools/rule-load.mjs --check",
    "verification:plan": "node tools/verification.mjs",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss,html}\" \"e2e/**/*.ts\"",
    "lint": "eslint .",
    "work:build": "node tools/work-items.mjs build",
    "check:work": "node tools/work-items.mjs check",
    "work:close": "node tools/work-items.mjs close",
    "work:next": "node tools/work-items.mjs next",
    "work:pr": "node tools/work-items.mjs pr",
    "work:tasks": "node tools/work-items.mjs tasks"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@ngrx/signals": "^22.0.1",
    "leaflet": "^1.9.4",
    "mp4-muxer": "^5.2.2",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "1.9",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.8.0",
    "axe-core": "~4.14.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jsdom": "^30.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.0.0"
  }
}
